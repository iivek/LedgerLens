<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
      Deliberately no INTERNET permission here: this is the release
      manifest, and the app's core privacy claim is that it never requests
      network access. Metro's dev-server permission lives ONLY in
      src/debug/AndroidManifest.xml, merged into debug builds, never release.
    -->
    <uses-permission android:name="android.permission.CAMERA" />

    <application
      android:name=".MainApplication"
      android:label="@string/app_name"
      android:icon="@mipmap/ic_launcher"
      android:roundIcon="@mipmap/ic_launcher_round"
      android:allowBackup="false"
      android:theme="@style/AppTheme"
      android:usesCleartextTraffic="${usesCleartextTraffic}"
      android:supportsRtl="true">
      <!--
        Deliberately NOT declaring libOpenCL.so as a uses-native-library.
        Tried it (2026-08-16): llama.rn's OpenCL backend registration calls
        ggml_abort(), a hard SIGABRT crash, not a graceful fallback, when it
        can't find a properly-supported OpenCL device. Confirmed on this
        project's own test device (Snapdragon 778G+ / Adreno 642L, below the
        Adreno 700+ tier llama.rn's README lists as supported). Without this
        declaration, libOpenCL.so fails to *load* at all and llama.rn falls
        back to its next-best CPU-only variant cleanly. With it declared,
        the library loads but then crashes the whole app on unsupported
        hardware. Only re-add this once paired with real testing on
        confirmed Adreno 700+ / Snapdragon 8 Gen 1+ hardware. Don't
        re-enable blind, it's strictly worse on anything below that tier.
      -->
      <activity
        android:name=".MainActivity"
        android:label="@string/app_name"
        android:configChanges="keyboard|keyboardHidden|orientation|screenLayout|screenSize|smallestScreenSize|uiMode"
        android:launchMode="singleTask"
        android:windowSoftInputMode="adjustResize"
        android:exported="true">
        <intent-filter>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent-filter>
      </activity>
    </application>
</manifest>
