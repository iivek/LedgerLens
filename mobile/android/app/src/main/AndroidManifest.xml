<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
      Deliberately no INTERNET permission here: this is the release
      manifest, and the app's core privacy claim is that it never requests
      network access. Metro's dev-server permission lives ONLY in
      src/debug/AndroidManifest.xml, merged into debug builds, never release.
    -->
    <uses-permission android:name="android.permission.CAMERA" />

    <application
      android:name=".MainApplication"
      android:label="@string/app_name"
      android:icon="@mipmap/ic_launcher"
      android:roundIcon="@mipmap/ic_launcher_round"
      android:allowBackup="false"
      android:theme="@style/AppTheme"
      android:usesCleartextTraffic="${usesCleartextTraffic}"
      android:supportsRtl="true">
      <!--
        Lets llama.rn load libOpenCL.so for GPU-accelerated inference.

        REQUIRES a supported Adreno/OpenCL tier (verified: Adreno 825 on a
        Nothing Phone 3, Snapdragon 8s Gen 4). CONFIRMED UNSAFE on a
        Snapdragon 778G+ / Adreno 642L device (2026-08-16): OpenCL backend
        registration called ggml_abort(), a hard SIGABRT crash, not a
        graceful fallback, because that GPU isn't in llama.cpp's supported
        tier. This is a single shared manifest with no runtime chip-tier
        detection, so installing this build on unsupported hardware WILL
        crash on model load. Do not ship broadly with this declared until
        that gap is closed (runtime capability check, or confirmation from
        a newer llama.rn that registration fails gracefully instead of
        aborting).

        HISTORY: on the Nothing Phone 3, this measured 18.8s extractions
        with exact-match accuracy (2026-08-16), then was suspected (wrongly)
        of degrading and removed (2026-08-17) when extraction started
        failing; the real cause, found the same session, was severe SoC
        thermal throttling (Thermal Status SEVERE, CPU cores up to 99.9C),
        confirmed via `dumpsys thermalservice` and an emulator control
        comparison. Re-verified cool and correct with this declaration
        ABSENT on 2026-08-24 (CPU-only, ~2min/extraction). Re-enabling here
        the same day specifically to re-verify the accelerated path on the
        now-cooled Nothing Phone 3, with thermals monitored throughout the
        test; see CLAUDE.md's mobile caveat section for the full evidence
        chain and this re-verification's result once recorded.
      -->
      <uses-native-library
        android:name="libOpenCL.so"
        android:required="false" />
      <activity
        android:name=".MainActivity"
        android:label="@string/app_name"
        android:configChanges="keyboard|keyboardHidden|orientation|screenLayout|screenSize|smallestScreenSize|uiMode"
        android:launchMode="singleTask"
        android:windowSoftInputMode="adjustResize"
        android:exported="true">
        <intent-filter>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent-filter>
      </activity>
    </application>
</manifest>
