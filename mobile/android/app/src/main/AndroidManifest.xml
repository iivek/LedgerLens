<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
      Deliberately no INTERNET permission here: this is the release
      manifest, and the app's core privacy claim is that it never requests
      network access. Metro's dev-server permission lives ONLY in
      src/debug/AndroidManifest.xml, merged into debug builds, never release.
    -->
    <uses-permission android:name="android.permission.CAMERA" />

    <application
      android:name=".MainApplication"
      android:label="@string/app_name"
      android:icon="@mipmap/ic_launcher"
      android:roundIcon="@mipmap/ic_launcher_round"
      android:allowBackup="false"
      android:theme="@style/AppTheme"
      android:usesCleartextTraffic="${usesCleartextTraffic}"
      android:supportsRtl="true">
      <!--
        Lets llama.rn load libOpenCL.so for GPU-accelerated inference.

        RE-ENABLED 2026-08-16 specifically to test on a Nothing Phone (3)
        (Snapdragon 8s Gen 4 / SM8735, Adreno 825), two generations past
        the floor llama.cpp's own OPENCL.md lists as verified (Adreno 750,
        Snapdragon 8 Gen 3; A6x-series GPUs are explicitly called out there
        as "likely not supported due to outdated driver and compiler").

        HISTORY: first tried on 2026-08-16 with a Snapdragon 778G+ / Adreno
        642L device (this project's other test phone, an A6x-class GPU).
        libOpenCL.so loaded, but llama.rn's OpenCL backend registration then
        called ggml_abort(), a hard SIGABRT crash, not a graceful fallback,
        because that GPU isn't in its supported tier. Reverted at the time;
        without this declaration, libOpenCL.so fails to load at all and
        llama.rn falls back to its next-best CPU-only variant cleanly.

        REMAINING RISK: this is a single shared manifest, so installing
        this same build on unsupported hardware (e.g. that 778G+ device
        again) will reproduce the crash. Not yet safe to ship broadly as
        is; would need either runtime chip-capability detection before
        attempting the OpenCL variant, or confirmation from a newer
        llama.rn that this registration path fails gracefully instead of
        aborting.
      -->
      <uses-native-library
        android:name="libOpenCL.so"
        android:required="false" />
      <activity
        android:name=".MainActivity"
        android:label="@string/app_name"
        android:configChanges="keyboard|keyboardHidden|orientation|screenLayout|screenSize|smallestScreenSize|uiMode"
        android:launchMode="singleTask"
        android:windowSoftInputMode="adjustResize"
        android:exported="true">
        <intent-filter>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent-filter>
      </activity>
    </application>
</manifest>
